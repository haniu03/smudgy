{
  "version": "0.14.0",
  "description": "Maps NukeFire from its rich NukeFire.Map.Local GMCP snapshots.",
  "entry": "index.ts",
  "min_smudgy_version": "0.5.0",
  "dependencies": [
    "smudgy://kapusniak/nukefire-gmcp"
  ],
  "requires": [
    "smudgy://kapusniak/nukefire-gmcp"
  ],
  "hosts": [
    "tdome.nukefire.org"
  ],
  "permissions": {
    "write": [
      "$DATA"
    ],
    "smudgy": {
      "session": [
        "echo"
      ],
      "mapper": [
        "write"
      ],
      "interop": [
        "read"
      ],
      "gmcp": [
        "send"
      ]
    }
  }
}
