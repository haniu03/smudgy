+/// Families opted out of ligature substitutions via
+/// [`set_ligatures_enabled`].
+fn no_ligature_families() -> &'static RwLock<HashSet<String>> {
+    static NO_LIGATURE_FAMILIES: OnceLock<RwLock<HashSet<String>>> =
+        OnceLock::new();
+
+    NO_LIGATURE_FAMILIES.get_or_init(|| RwLock::new(HashSet::new()))
+}
+
+/// Enables or disables ligature substitutions (`liga`, `clig`, `calt`, and
+/// `dlig`) for every run shaped with the given font family. Ligatures are
+/// enabled by default; disabling them suits monospace grids, where
+/// contextual substitutions break column alignment.
+///
+/// Takes effect the next time affected text is shaped; callers are
+/// responsible for invalidating any cached paragraphs.
+pub fn set_ligatures_enabled(family: &str, enabled: bool) {
+    let mut families = no_ligature_families()
+        .write()
+        .expect("Write no-ligature families");
+
+    if enabled {
+        let _ = families.remove(family);
+    } else {
+        let _ = families.insert(family.to_owned());
+    }
+}
